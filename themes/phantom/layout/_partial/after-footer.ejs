<!-- Lightbox -->
<script>
$(function() {
  var $overlay = $('<div id="tsupo-lightbox"><img /></div>').appendTo('body');
  var $img = $overlay.find('img');

  function openLightbox(src) {
    $img.attr('src', src);
    $overlay.fadeIn(200);
  }

  function closeLightbox() {
    $overlay.fadeOut(200);
  }

  $('.post-image a[href]').on('click', function(e) {
    e.preventDefault();
    openLightbox($(this).attr('href'));
  });

  $('.post-image img').not('.post-image a img').on('click', function() {
    openLightbox($(this).attr('src'));
  }).css('cursor', 'zoom-in');

  $('span.image.main img').on('click', function() {
    openLightbox($(this).attr('src'));
  }).css('cursor', 'zoom-in');

  $overlay.on('click', closeLightbox);

  $(document).on('keydown', function(e) {
    if (e.key === 'Escape') closeLightbox();
  });
});
</script>

<!-- Disqus Comments -->
<% if (theme.comments && theme.comments.disqus_shortname){ %>
<script type="text/javascript">
    var disqus_shortname = '<%= theme.comments.disqus_shortname %>';

    (function(){
        var dsq = document.createElement('script');
        dsq.type = 'text/javascript';
        dsq.async = true;
        dsq.src = '//' + disqus_shortname + '.disqus.com/<% if (page.comments){ %>embed.js<% } else { %>count.js<% } %>';
        (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
    }());
</script>
<% } %>
